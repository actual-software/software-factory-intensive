# ============================================================================
# Software Factory Intensive — Integration Credentials
# ============================================================================
# Copy this file to .env and fill in the values for the services you use.
# Only configure the integrations relevant to your project — everything is
# optional. Run `gc workshop doctor` after filling in to validate.
# ============================================================================

# ── Issue Trackers (pick one or more) ─────────────────────────────────────

# Jira Cloud
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
export JIRA_URL="https://your-company.atlassian.net"
export JIRA_USERNAME="your-email@company.com"
export JIRA_API_TOKEN=""
export JIRA_PROJECT="PROJ"

# Linear
# Token: https://linear.app/settings/api
export LINEAR_API_KEY=""
export LINEAR_TEAM_ID=""

# GitHub Issues
# Token: https://github.com/settings/tokens (needs repo scope)
export GITHUB_TOKEN=""
export GITHUB_OWNER=""
export GITHUB_REPO=""

# GitLab Issues
# Token: https://gitlab.com/-/user_settings/personal_access_tokens
export GITLAB_URL="https://gitlab.com"
export GITLAB_TOKEN=""
export GITLAB_PROJECT_ID=""

# Azure DevOps
# Token: https://dev.azure.com/{org}/_usersSettings/tokens
export AZURE_DEVOPS_ORG=""
export AZURE_DEVOPS_PROJECT=""
export AZURE_DEVOPS_PAT=""

# Notion
# Integration: https://www.notion.so/my-integrations
export NOTION_TOKEN=""

# Asana
# Token: https://app.asana.com/0/developer-console
export ASANA_ACCESS_TOKEN=""

# ── Source Control ────────────────────────────────────────────────────────

# GitHub (if different from Issues token above)
export GITHUB_PERSONAL_ACCESS_TOKEN="${GITHUB_TOKEN}"

# GitLab (reuses GITLAB_TOKEN above)

# ── Observability ─────────────────────────────────────────────────────────

# Sentry
# Token: https://sentry.io/settings/account/api/auth-tokens/
export SENTRY_AUTH_TOKEN=""
export SENTRY_ORG=""
export SENTRY_PROJECT=""

# DataDog
# Keys: https://app.datadoghq.com/organization-settings/api-keys
export DATADOG_API_KEY=""
export DATADOG_APP_KEY=""
export DATADOG_SITE="datadoghq.com"

# PostHog
# Key: https://app.posthog.com/project/settings
export POSTHOG_API_KEY=""
export POSTHOG_HOST="https://app.posthog.com"

# Grafana Cloud
# Token: https://grafana.com/orgs/<org>/api-keys
export GRAFANA_URL=""
export GRAFANA_API_KEY=""

# Prometheus (self-hosted push gateway)
export PROMETHEUS_PUSHGATEWAY_URL=""

# Gas City OpenTelemetry (sends metrics to any OTel-compatible backend)
export GC_OTEL_METRICS_URL=""
export GC_OTEL_LOGS_URL=""

# ── Cloud Providers ───────────────────────────────────────────────────────

# AWS (configure via `aws configure` or set these)
export AWS_PROFILE=""
export AWS_REGION="us-west-2"

# Google Cloud (configure via `gcloud auth login` or set these)
export GOOGLE_CLOUD_PROJECT=""
export GOOGLE_APPLICATION_CREDENTIALS=""

# Azure (configure via `az login` or set these)
export AZURE_SUBSCRIPTION_ID=""
export AZURE_TENANT_ID=""

# ── CI/CD ─────────────────────────────────────────────────────────────────

# GitHub Actions (reuses GITHUB_TOKEN)

# CircleCI
# Token: https://app.circleci.com/settings/user/tokens
export CIRCLECI_TOKEN=""

# ── Communication ─────────────────────────────────────────────────────────

# Slack
# Token: https://api.slack.com/apps → OAuth & Permissions
export SLACK_BOT_TOKEN=""
export SLACK_CHANNEL=""

# Discord
# Token: https://discord.com/developers/applications
export DISCORD_BOT_TOKEN=""
export DISCORD_CHANNEL_ID=""
